# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the site (no trailing slash). Localhost during phase 1.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "systeme" (default): waiting list and free guide buttons link to the Systeme.io pages, no form on this page.
# "native": the forms on this page post to /api/leads (needs Supabase, optional Systeme.io API key).
NEXT_PUBLIC_LEAD_CAPTURE=systeme

# "waitlist" (doors closed) or "open" (doors open, CTAs go to the cart).
NEXT_PUBLIC_LAUNCH_MODE=waitlist
# ISO date of the launch. Leave empty to hide the countdown.
NEXT_PUBLIC_LAUNCH_DATE=

# Hero video. Set one or leave both empty for the brand placeholder.
NEXT_PUBLIC_HERO_YOUTUBE_ID=
NEXT_PUBLIC_HERO_VIMEO_ID=

# Supabase (Project Settings > API). Leave empty to use the local JSON fallback.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Systeme.io (Settings > Public API keys). Tags can be the numeric tag id or the exact tag name.
SYSTEME_API_KEY=
SYSTEME_TAG_WAITLIST=FDP Waitlist
SYSTEME_TAG_FREE_GUIDE=Indulge in Wellness

# Tracking. Empty on localhost. Filled in phase 3.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
