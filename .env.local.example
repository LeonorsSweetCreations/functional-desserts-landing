# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the site (no trailing slash). Localhost during phase 1.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Forms. "native" (default): the waiting list form (hero and price card) and the free guide form send the
# contact to Systeme.io (SYSTEME_API_KEY below). "systeme": no forms, the buttons link to the Systeme.io pages
# (https://healthy.leonors.com/waiting-list and the opt-in page).
NEXT_PUBLIC_LEAD_CAPTURE=native

# "waitlist" (doors closed) or "open" (doors open, CTAs go to the cart).
NEXT_PUBLIC_LAUNCH_MODE=waitlist
# ISO date of the launch. Leave empty to hide the countdown.
NEXT_PUBLIC_LAUNCH_DATE=
# Launch price in euros (e.g. 199). The page then shows €299 struck through and this price highlighted,
# with the payment plan recomputed at the same markup. Leave empty for the regular €299.
NEXT_PUBLIC_LAUNCH_PRICE=

# Hero video. Set one or leave both empty for the brand placeholder.
NEXT_PUBLIC_HERO_YOUTUBE_ID=
NEXT_PUBLIC_HERO_VIMEO_ID=

# Supabase (Project Settings > API). Optional: a copy of every lead. Leave empty to send contacts only to Systeme.io.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Systeme.io (Settings > Public API keys). Tags can be the numeric tag id or the exact tag name.
# The API lists at most 100 tags per call; the exact names below exist in Leonor's account (checked 2026-10-15).
SYSTEME_API_KEY=
SYSTEME_TAG_WAITLIST=FDP Waitlist
SYSTEME_TAG_FREE_GUIDE=[EBOOK][REGISTO] Indulge in Wellness

# Tracking. Empty on localhost. Filled in phase 3.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
